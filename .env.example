# Copy to .env for local dev. PLACEHOLDERS ONLY — never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres connection string (see docker-compose.yml for local DB)
DATABASE_URL=postgresql://fpp:fpp_changeme@localhost:5432/fpp_dev

# 32+ chars. Generate: openssl rand -hex 32
SESSION_SECRET=changeme_generate_32_plus_chars_with_openssl_rand_hex_32
APP_BASE_URL=http://localhost:3000

# Client portal magic-link TTL in hours (default 168 = 7d, max 720)
MAGIC_LINK_TTL_HOURS=168

# Payments (Stripe candidate). Leave empty until provider is connected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Storage abstraction (local/S3-compatible). Leave empty for Noop provider in dev.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email provider. Leave empty for Noop provider in dev.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@example.com

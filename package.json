{
  "name": "freelance-payment-protection",
  "version": "0.19.0",
  "description": "Payment-protection workflow for freelancers: milestones, approvals, verified payments, controlled delivery, evidence timeline.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings=0",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --check src tests prisma",
    "format:fix": "prettier --write src tests prisma",
    "typecheck": "tsc --noEmit",
    "checks": "npm run typecheck && npm run lint && npm run format && npm run test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prisma/client": "^6.4.1",
    "@types/node": "^22.13.0",
    "eslint": "^9.22.0",
    "@eslint/js": "^9.22.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "prettier": "^3.5.3",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "vitest": "^3.1.2"
  }
}
